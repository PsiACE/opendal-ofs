set -euo pipefail

clean_env=(
  "PATH=${PATH:?}"
  "LANG=${LANG:-C.UTF-8}"
)
for name in OFS_BIN OFS_CONFIG OFS_VOLUME OFS_RUN_ROOT OFS_SANDBOX_A \
  OFS_SANDBOX_B OFS_SANDBOX_C OFS_STATE_A OFS_STATE_B OFS_STATE_C; do
  if [[ -v $name ]]; then
    clean_env+=("$name=${!name}")
  fi
done
exec env -i "${clean_env[@]}" /bin/bash "$@"
